AWSTemplateFormatVersion: '2010-09-09'
Description: >
  Creates an S3 bucket configured for static website hosting, fronted by a
  CloudFront distribution using Origin Access Control (OAC). The bucket
  itself blocks all public access; content is only reachable through
  CloudFront.

Parameters:
  BucketName:
    Type: String
    Description: >
      Globally unique name for the S3 bucket (must be lowercase, no
      underscores, and follow S3 bucket naming rules).
    AllowedPattern: '^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$'
    ConstraintDescription: >
      Must be a valid S3 bucket name: lowercase letters, numbers, dots,
      and hyphens only, 3-63 characters.

  IndexDocument:
    Type: String
    Default: index.html
    Description: The file to serve as the website's home page.

  ErrorDocument:
    Type: String
    Default: error.html
    Description: The file to serve when a request results in an error (e.g. 404).

  PriceClass:
    Type: String
    Default: PriceClass_100
    AllowedValues:
      - PriceClass_100
      - PriceClass_200
      - PriceClass_All
    Description: CloudFront price class (controls which edge locations are used).

Resources:

  CloudFrontBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Ref BucketName
      AccessControl: Private
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true
      WebsiteConfiguration:
        IndexDocument: !Ref IndexDocument
        ErrorDocument: !Ref ErrorDocument
      OwnershipControls:
        Rules:
          - ObjectOwnership: BucketOwnerEnforced
    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain

  # Bucket policy grants access only to this specific CloudFront distribution,
  # via Origin Access Control (SigV4-signed requests to the S3 REST endpoint).
  CloudFrontBucketPolicy:
    Type: AWS::S3::BucketPolicy
    Properties:
      Bucket: !Ref CloudFrontBucket
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Sid: AllowCloudFrontServicePrincipalReadOnly
            Effect: Allow
            Principal:
              Service: cloudfront.amazonaws.com
            Action: 's3:GetObject'
            Resource: !Sub '${CloudFrontBucket.Arn}/*'
            Condition:
              StringEquals:
                'AWS:SourceArn': !Sub 'arn:aws:cloudfront::${AWS::AccountId}:distribution/${CloudFrontDistribution}'

  CloudFrontOriginAccessControl:
    Type: AWS::CloudFront::OriginAccessControl
    Properties:
      OriginAccessControlConfig:
        Name: !Sub '${BucketName}-oac'
        Description: OAC for CloudFront to access the S3 static website bucket
        OriginAccessControlOriginType: s3
        SigningBehavior: always
        SigningProtocol: sigv4

  CloudFrontDistribution:
    Type: AWS::CloudFront::Distribution
    Properties:
      DistributionConfig:
        Enabled: true
        Comment: !Sub 'CDN for ${BucketName} static website'
        DefaultRootObject: !Ref IndexDocument
        PriceClass: !Ref PriceClass
        HttpVersion: http2and3
        IPV6Enabled: true
        Origins:
          - Id: S3CloudFrontOrigin
            # Uses the bucket's REST (regional) domain name, not the S3
            # website endpoint — OAC/SigV4 is only supported against the
            # REST endpoint. S3OriginConfig + OriginAccessControlId is what
            # tells CloudFront to sign requests with OAC.
            DomainName: !GetAtt CloudFrontBucket.RegionalDomainName
            S3OriginConfig:
              OriginAccessIdentity: ''
            OriginAccessControlId: !GetAtt CloudFrontOriginAccessControl.Id
        DefaultCacheBehavior:
          TargetOriginId: S3CloudFrontOrigin
          ViewerProtocolPolicy: redirect-to-https
          AllowedMethods:
            - GET
            - HEAD
          CachedMethods:
            - GET
            - HEAD
          Compress: true
          CachePolicyId: 658327ea-f89d-4fab-a63d-7e88639e58f6 # AWS Managed-CachingOptimized
        CustomErrorResponses:
          - ErrorCode: 403
            ResponseCode: 404
            ResponsePagePath: !Sub '/${ErrorDocument}'
          - ErrorCode: 404
            ResponseCode: 404
            ResponsePagePath: !Sub '/${ErrorDocument}'

Outputs:
  BucketName:
    Description: Name of the S3 bucket hosting the website
    Value: !Ref CloudFrontBucket

  S3WebsiteEndpointURL:
    Description: >
      Direct S3 website endpoint URL (kept for reference only — this
      endpoint is not publicly accessible since the bucket blocks public
      access; use CloudFrontURL instead).
    Value: !GetAtt CloudFrontBucket.WebsiteURL

  BucketDomainName:
    Description: Regional S3 domain name of the bucket (CloudFront origin)
    Value: !GetAtt CloudFrontBucket.RegionalDomainName

  BucketArn:
    Description: ARN of the S3 bucket
    Value: !GetAtt CloudFrontBucket.Arn

  CloudFrontDistributionId:
    Description: ID of the CloudFront distribution
    Value: !Ref CloudFrontDistribution

  CloudFrontDomainName:
    Description: CloudFront distribution domain name
    Value: !GetAtt CloudFrontDistribution.DomainName

  CloudFrontURL:
    Description: Public URL for the website via CloudFront
    Value: !Sub 'https://${CloudFrontDistribution.DomainName}'